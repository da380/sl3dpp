{
  "problem": "quasi_static",
  "model": {"deck": "../data/prem8.gia.deck", "format": "maxwell"},
  "lmax": 24,
  "times": {"start_kyr_bp": 21.0, "end_kyr_bp": 0.0, "nodes": 43},
  "forcing": {"ice": {"file": "../data/synthetic_earth.nc"}},
  "ocean": {
    "topography": {"file": "../data/synthetic_earth.nc", "at": "start"}
  },
  "rotation": "full",
  "moments": "hydrostatic",
  "record_stride": 6,
  "adjoint": "continuous",
  "measurements": [
    {"type": "relative_sea_level_cap", "name": "hudson_bay_sea_level",
     "latitude": 60, "longitude": 275, "width_deg": 4, "date_kyr_bp": 0},
    {"type": "relative_sea_level_point", "name": "far_field_sea_level",
     "latitude": -17.5, "longitude": 210.5, "date_kyr_bp": 10},
    {"type": "rotation", "name": "length_of_day", "component": "z"},
    {"type": "stokes_coefficient", "name": "j2", "degree": 2, "order": 0},
    {"type": "decay_time", "name": "hudson_bay_decay",
     "latitude": 60, "longitude": 275, "width_deg": 4,
     "window_start_kyr_bp": 7, "window_end_kyr_bp": 0,
     "time_uncertainty_kyr": 0.1, "value_uncertainty_m": 1.0}
  ],
  "output": "out/kernel1d"
}
