{
  "problem": "quasi_static",
  "model": {"deck": "../data/prem8_down.gia.deck", "format": "maxwell"},
  "discretisation": {"lmax": 16},
  "times": {"start_kyr_bp": 16.0, "end_kyr_bp": 6.0, "nodes": 81},
  "forcing": {
    "ice_change": [{"thickness": {"file": "../data/synthetic_earth.nc"}}]
  },
  "ocean": {
    "at": "start",
    "topography": {"file": "../data/synthetic_earth.nc"},
    "ice": {"file": "../data/synthetic_earth.nc"}
  },
  "rotation": "none",
  "solver": {"scheme": "exponential_trapezoid"},
  "output": {"surface": "out/timestep_down_n80/timestep_down_n80.nc"}
}
