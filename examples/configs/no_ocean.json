{
  "problem": "static",
  "model": {"deck": "../data/prem8.elastic.deck", "format": "elastic",
            "moduli": {"file": "../data/synthetic_moduli.nc"}},
  "discretisation": {"lmax": 16},
  "forcing": {
    "load": [{"cap": {"latitude": 60.0, "longitude": -85.0, "width_deg": 10.0,
                      "amplitude_kg_m2": 1.834e6}}],
    "tide": [{"degree": 2, "order": 0, "amplitude_m2_s2": 1.0}]
  },
  "rotation": "none",
  "solver": {"step_rtol": 1e-10, "step_max_iterations": 200},
  "output": {"surface": "out/no_ocean/no_ocean.nc",
             "exchange": "out/no_ocean/no_ocean.txt",
             "volume": "out/no_ocean/no_ocean_volume.nc"}
}
