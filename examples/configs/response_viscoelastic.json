{
  "model": {"deck": "../prem8.elastic.deck", "format": "elastic",
            "viscosity": {"file": "../viscosity_log.nc"},
            "moduli": {"file": "../synthetic_moduli.nc"}},
  "lmax": 16,
  "times": {"start_kyr": 0.0, "end_kyr": 12.0, "nodes": 25},
  "forcing": {
    "load": [{"cap": {"latitude": 60.0, "longitude": -85.0, "width_deg": 10.0,
                      "amplitude_kg_m2": 1.834e6},
              "history_kyr": [[0.0, 0.0], [6.0, 1.0], [7.0, 0.0]]}],
    "tide": [{"degree": 2, "order": 0, "amplitude_m2_s2": 1.0}]
  },
  "solver": {"scheme": "exponential_trapezoid", "step": "fixed_point"},
  "output": {"surface": "out/response_viscoelastic.nc",
             "exchange": "out/response_viscoelastic_{node}.txt",
             "exchange_nodes": [0, 12, 14, 24]}
}
