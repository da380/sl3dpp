{
  "problem": "static",
  "model": {"deck": "../data/prem8.postseismic.deck", "format": "maxwell"},
  "discretisation": {"lmax": 96},
  "forcing": {
    "seismic": [{"fault_file": {"file": "../data/megathrust.nc",
                                "cells_along_strike": 36, "cells_down_dip": 6,
                                "place_by": "depth"}}]
  },
  "ocean": {
    "date_kyr_bp": 0.0,
    "topography": {"file": "../data/synthetic_earth.nc"},
    "ice": {"file": "../data/synthetic_earth.nc"}
  },
  "rotation": "full",
  "output": {"surface": "out/sea_level_static_megathrust/sea_level_static_megathrust.nc",
             "fields": ["horizontal_displacement"],
             "smoothing": {"kind": "gaussian", "width_deg": 2.0}}
}
